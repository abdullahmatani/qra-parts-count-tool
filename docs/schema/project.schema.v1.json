        "pipeLengthCounting": {
          "default": false,
          "type": "boolean"
        },
        "units": {
          "default": {},
          "type": "object",
          "properties": {
            "size": {
              "default": "in",
              "type": "string",
              "enum": [
                "in",
                "DN"
              ]
            },
            "pressure": {
              "default": "barg",
              "type": "string",
              "maxLength": 20
            },
            "temperature": {
              "default": "°C",
              "type": "string",
              "maxLength": 20
            },
            "length": {
              "default": "m",
              "type": "string",
              "const": "m"
            }
